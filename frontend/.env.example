# Mantle Network RPC URLs
NEXT_PUBLIC_MANTLE_TESTNET_RPC=https://rpc.ankr.com/mantle_sepolia
NEXT_PUBLIC_MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# Contract Addresses (update after deployment)
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=your_agent_registry_address
NEXT_PUBLIC_VOTING_POOL_ADDRESS=your_voting_pool_address
NEXT_PUBLIC_TURING_ARENA_ADDRESS=your_turing_arena_address

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
